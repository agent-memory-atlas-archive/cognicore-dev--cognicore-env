# Required environment variables
API_BASE_URL=https://router.huggingface.co/v1
MODEL_NAME=Qwen/Qwen2.5-72B-Instruct
HF_TOKEN=your_huggingface_token_here

# Gemini API key (used by examples/gemini_full_test.py and the scripts/probes/ connectivity probes)
GEMINI_API_KEY=your_gemini_api_key_here

# Environment URL (for inference.py to connect to)
# When running locally:
ENV_URL=http://localhost:7860
# When running against HF Space:
# ENV_URL=https://KaushalT2004-cognicore-openenv.hf.space

# ==============================================================================
# AI Content Studio Configuration
# ==============================================================================
# Set to 'true' to run entirely in mock mode without external API calls:
MOCK_MODE=false

# Figma Personal Access Token (from figma.com/settings -> Personal access tokens)
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token_here

# Groq API Key (for LLM script & storyboard generation)
GROQ_API_KEY=your_groq_api_key_here
# Optional LLM settings:
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Sarvam AI Key (for Indian language translation & localization)
SARVAM_API_KEY=your_sarvam_api_key_here

# ElevenLabs API Key (for realistic voice narration synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Canva API Key / App credentials (OAuth required; mock mode active by default)
CANVA_API_KEY=your_canva_api_key_or_placeholder

# Optional Studio Host & Port
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8501

